{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python Template",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/src/main.py",
      "cwd": "${workspaceFolder}",
      "windows": {
        "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe"
      },
      "linux": {
        "python": "${workspaceFolder}/.venv/bin/python"
      },
      "osx": {
        "python": "${workspaceFolder}/.venv/bin/python"
      },
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONUNBUFFERED": "1"
      }
    }
  ]
}
